flowchart TD
    IN["STORE of a record at position N of a DID"]
    FORM{"Canonical, bound to the key,<br/>key and code at N reach the root?"}
    HOLDS{"Does the replica<br/>hold a record?"}
    CHECK["Network check<br/>(empty replica diagram)"]
    SAME{"Same bytes?"}
    CMP{"N against the<br/>held position"}
    SIGH{"Signature verifies?"}
    SIGE{"Signature verifies?"}
    INV["InvalidRecord"]
    AS["AlreadyStored"]
    REP["Replace (compare and swap): Stored"]
    STALE["Stale"]
    CON["Conflict, the stored record stays<br/>logged as a repeated signing or as duplicity"]
    IN --> FORM
    FORM -- no --> INV
    FORM -- yes --> HOLDS
    HOLDS -- no --> CHECK
    HOLDS -- yes --> SAME
    SAME -- yes --> AS
    SAME -- no --> CMP
    CMP -- higher --> SIGH
    SIGH -- yes --> REP
    SIGH -- no --> INV
    CMP -- lower --> STALE
    CMP -- equal --> SIGE
    SIGE -- yes --> CON
    SIGE -- no --> INV
