flowchart TB
    S["64 positions: for each, a 32-byte seed<br/>and a random 32-byte activation code"]
    L["Leaf i = SHA-256(0x00, i, public key of seed i, code i)<br/>nodes up to the root"]
    B["Body of position 0<br/>key of position 0, seq 0,<br/>own DID written as did:iiot:self, no id, no treeProof"]
    G["Genesis<br/>hashAlg, height, sigAlg, version,<br/>initialBodyHash = SHA-256 of the canonical body,<br/>root"]
    DID["DID = did:iiot: + base64url of SHA-256(canonical genesis)<br/>DHT key = that hash"]
    F["Document 0: the DID in place of did:iiot:self, id,<br/>treeProof = code 0, genesis, path of leaf 0"]
    SIG["Sign with the key of position 0 (ML-DSA-65)"]
    R["Record: algorithm, signature, document<br/>published under the DHT key"]
    S --> L --> G
    B --> G
    G --> DID --> F --> SIG --> R
