{
  "theme": "base",
  "fontFamily": "Lato, 'Noto Sans', 'Helvetica Neue', Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Lato, 'Noto Sans', 'Helvetica Neue', Arial, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#eef4fb",
    "primaryBorderColor": "#5b7fae",
    "primaryTextColor": "#0f1f33",
    "secondaryColor": "#f3f5f8",
    "tertiaryColor": "#f8fafc",
    "lineColor": "#5c6b7e",
    "textColor": "#1f2a37",
    "actorBkg": "#1f3a5f",
    "actorBorder": "#1f3a5f",
    "actorTextColor": "#ffffff",
    "actorLineColor": "#b8c2cf",
    "signalColor": "#2d3a4a",
    "signalTextColor": "#1a2533",
    "noteBkgColor": "#f4f6f9",
    "noteBorderColor": "#d3dae3",
    "noteTextColor": "#3a4757",
    "labelBoxBkgColor": "#1f3a5f",
    "labelBoxBorderColor": "#1f3a5f",
    "labelTextColor": "#ffffff",
    "loopTextColor": "#1f3a5f",
    "sequenceNumberColor": "#ffffff",
    "activationBkgColor": "#e6edf7",
    "activationBorderColor": "#5b7fae",
    "clusterBkg": "#f6f8fb",
    "clusterBorder": "#c9d3df",
    "titleColor": "#1f3a5f",
    "edgeLabelBackground": "#ffffff"
  },
  "themeCSS": ".actor { rx: 8px; ry: 8px; } text.actor > tspan { font-weight: 700; } .note { rx: 6px; ry: 6px; } .labelBox { rx: 4px; ry: 4px; } .loopLine { stroke: #8fa3bb !important; stroke-width: 1.4px; stroke-dasharray: 5 4; } .loopText, .loopText > tspan { font-style: italic; fill: #1f3a5f; } .messageText { font-size: 14px; }",
  "sequence": {
    "mirrorActors": false,
    "actorMargin": 70,
    "boxMargin": 12,
    "boxTextMargin": 6,
    "noteMargin": 12,
    "messageMargin": 42,
    "bottomMarginAdj": 8,
    "useMaxWidth": false
  }
}
