+/// Send the record this node holds for a DID to the `k` nodes closest to it,
+/// as the hourly republication does, but at once (added for a measurement,
+/// not part of `main`).
+async fn push(node: &Node, target: &str) -> Value {
+    let uuid = target.strip_prefix("did:iiot:").unwrap_or(target);
+    let key = digest(uuid);
+    let server = node.server.read().await;
+    let Some(record) = server.storage.get(&key) else {
+        return json!({ "did": format!("did:iiot:{uuid}"), "held": false });
+    };
+    let Some(protocol) = server.protocol.clone() else {
+        return json!({ "error": "the node is not listening" });
+    };
+    let started = Instant::now();
+    let target_node = auth_kademlia_rs::node::Node::from_id(key);
+    let neighbours = protocol.router.read().await.find_neighbors(&target_node, None);
+    let replicas = NodeSpiderCrawl::new(
+        Arc::clone(&protocol),
+        target_node,
+        neighbours,
+        server.ksize,
+        server.alpha,
+    )
+    .find()
+    .await;
+    let answers = futures::future::join_all(
+        replicas
+            .iter()
+            .map(|replica| protocol.call_store_rpc(replica, key, record.clone())),
+    )
+    .await;
+    let mut tally = std::collections::BTreeMap::<String, usize>::new();
+    for answer in &answers {
+        let name = match answer {
+            Some(status) => format!("{status:?}"),
+            None => "no answer".to_string(),
+        };
+        *tally.entry(name).or_default() += 1;
+    }
+    let ms = elapsed_ms(started);
+    log::info!("push did:iiot:{uuid} to {} replicas: {tally:?} ({ms} ms)", answers.len());
+    json!({ "did": format!("did:iiot:{uuid}"), "held": true, "sent": answers.len(), "answers": tally, "ms": ms })
+}
